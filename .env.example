# copy to .env and adjust
APP_PORT=8096

# Local AI (Ollama on your network)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT_S=600
# products sent to the model per request when categorising
AI_BATCH_SIZE=20
# long side in px of receipt photos sent to the model
LLM_MAX_IMAGE_SIDE=3000

# people created on first start (rename/add more later on the Import page)
PEOPLE=Me,Partner

# the app runs as this uid/gid (owner of ./data)
APP_UID=1000
APP_GID=1000
